# Copier en .env.local (jamais versionné) pour l'exécution locale,
# et reporter les mêmes variables dans Vercel > Settings > Environment Variables.

# Chaîne de connexion Postgres (Supabase > Connect > Transaction pooler),
# en remplaçant l'utilisateur par le rôle applicatif dédié `assidia_app`.
DATABASE_URL=postgresql://assidia_app.REF_DU_PROJET:MOT_DE_PASSE@HOTE.pooler.supabase.com:6543/postgres

# Clé de signature des cookies de session. Chaîne aléatoire longue ; la changer
# déconnecte tout le monde. Générer avec : openssl rand -hex 32
SESSION_SECRET=

# Fuseau horaire de l'établissement : sert à comparer l'heure d'arrivée (horodatage UTC)
# à l'heure de début de séance (heure locale "HH:MM").
APP_TZ=Africa/Casablanca

# Utilisés uniquement pour créer le tout premier compte sur une base vierge.
# Inutiles ici, la base ayant été migrée avec le compte existant.
# PTG_ADMIN_USER=admin
# PTG_ADMIN_PASSWORD=
